# Copy this file to .env in this folder and paste your keys after the = signs.
# .env is gitignored, so your keys never end up in the (public) repo.
# Keys already set in your shell take priority over this file.

# Needed for the terminal agent (python agent.py). The Claude desktop app doesn't need it.
ANTHROPIC_API_KEY=

# Optional: precise object pointing with locate(). Get one from Google AI Studio.
GEMINI_API_KEY=
